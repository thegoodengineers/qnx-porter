--- /dev/null
+++ b/ports/yyjson/README.md
@@ -0,0 +1,17 @@
+# yyjson for QNX 8.0
+
+Generated by [qnx-porter](https://github.com/thegoodengineers/qnx-porter) from its automatic port of
+yyjson `0.10.0` (https://github.com/ibireme/yyjson.git). On a QNX 8.0 x86_64 target (QEMU) 12/12 of its own tests passed. Full report:
+`ports-2024/yyjson/REPORT.md` in qnx-porter.
+
+## Build
+```bash
+source ~/qnx800/qnxsdp-env.sh
+git clone --depth 1 --recurse-submodules --shallow-submodules --branch 0.10.0 https://github.com/ibireme/yyjson.git yyjson
+QNX_PROJECT_ROOT="$(pwd)/yyjson" make -C build-files/ports/yyjson install JLEVEL=4
+```
+
+## QNX changes, each with its reason
+| rule | reason |
+|---|---|
+| link-libm | `__isinf` is in QNX's libm, not in libc: QNX's <math.h> implements isinf/isfinite/isnan as calls to __isinf etc. in libm, where glibc needs no library. Link with -lm. |
diff --git a/ports/yyjson/common.mk b/ports/yyjson/common.mk
new file mode 100644
index 0000000..7745ac3
--- /dev/null
+++ b/ports/yyjson/common.mk
@@ -0,0 +1,57 @@
+# Generated by qnx-porter from its QNX 8.0 port of yyjson 0.10.0 (see README.md).
+ifndef QCONFIG
+QCONFIG=qconfig.mk
+endif
+include $(QCONFIG)
+
+NAME=yyjson
+
+QNX_PROJECT_ROOT ?= $(PRODUCT_ROOT)/../../yyjson
+INSTALL_ROOT ?= $(INSTALL_ROOT_$(OS))
+PREFIX ?= /usr/local
+BUILD_TESTING ?= OFF
+CMAKE_BUILD_TYPE ?= Release
+# Static libraries, as in the tested port; set ON for shared ones.
+BUILD_SHARED_LIBS ?= OFF
+
+ALL_DEPENDENCIES = yyjson_all
+.PHONY: yyjson_all install check clean
+
+include $(MKFILES_ROOT)/qtargets.mk
+
+# QNX keeps pthread, rt and dl in libc: empty archives let `-lrt` and CMake's library checks succeed.
+STUBS = $(CURDIR)/build/stubs
+CFLAGS += -I$(INSTALL_ROOT)/$(PREFIX)/include
+LDFLAGS += -L$(STUBS)
+
+# CMAKE_INSTALL_LIBDIR is set because some projects include GNUInstallDirs only when not cross-compiling.
+CMAKE_ARGS = -DCMAKE_TOOLCHAIN_FILE=$(PROJECT_ROOT)/qnx.nto.toolchain.cmake \
+             -DCMAKE_SYSTEM_PROCESSOR=$(CPUVARDIR) \
+             -DCMAKE_INSTALL_PREFIX=$(INSTALL_ROOT)/$(CPUVARDIR)/$(PREFIX) \
+             -DCMAKE_INSTALL_INCLUDEDIR=$(INSTALL_ROOT)/$(PREFIX)/include \
+             -DCMAKE_INSTALL_LIBDIR=lib \
+             -DCMAKE_BUILD_TYPE=$(CMAKE_BUILD_TYPE) \
+             -DCMAKE_LIBRARY_PATH=/stubs \
+             -DEXTRA_CMAKE_C_FLAGS="$(CFLAGS)" \
+             -DEXTRA_CMAKE_CXX_FLAGS="$(CFLAGS)" \
+             -DEXTRA_CMAKE_LINKER_FLAGS="$(LDFLAGS)" \
+             -DCMAKE_C_STANDARD_LIBRARIES="-lm" \
+             -DCMAKE_CXX_STANDARD_LIBRARIES="-lm" \
+             -DBUILD_SHARED_LIBS=$(BUILD_SHARED_LIBS) \
+             -DBUILD_TESTING=$(BUILD_TESTING) \
+             -DYYJSON_BUILD_TESTS=ON
+
+ifndef NO_TARGET_OVERRIDE
+yyjson_all:
+	@mkdir -p $(STUBS) && for l in rt dl pthread; do [ -f $(STUBS)/lib$$l.a ] || printf '!<arch>\n' > $(STUBS)/lib$$l.a; done
+	@cd build && cmake $(CMAKE_ARGS) $(QNX_PROJECT_ROOT)
+	@cd build && cmake --build . $(MAKE_ARGS)
+
+install check: yyjson_all
+	@cd build && cmake --install .
+
+clean iclean spotless:
+	rm -rf build
+
+uninstall:
+endif
