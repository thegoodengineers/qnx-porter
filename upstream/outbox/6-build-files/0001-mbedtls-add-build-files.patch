--- /dev/null
+++ b/.github/workflows/mbedtls.yml
@@ -0,0 +1,48 @@
+name: mbedtls
+
+permissions:
+  contents: write
+  checks: write
+
+on:
+  workflow_dispatch:
+  push:
+    branches:
+      - main
+    paths:
+      - '.github/workflows/mbedtls.yml'
+      - 'ports/mbedtls/**'
+  pull_request:
+    branches:
+      - main
+    paths:
+      - '.github/workflows/mbedtls.yml'
+      - 'ports/mbedtls/**'
+
+jobs:
+
+  build:
+    runs-on: ubuntu-22.04-common
+    if: |
+      ((github.event_name == 'workflow_dispatch') ||
+      (github.event_name == 'push' && github.ref == 'refs/heads/main') ||
+      (github.event_name == 'pull_request' && contains(github.event.pull_request.title, 'mbedtls')))
+    steps:
+    - name: Checkout build-files
+      uses: actions/checkout@v4
+      with:
+        path: build-files
+
+    - name: Checkout mbedtls
+      uses: actions/checkout@v4
+      with:
+        repository: Mbed-TLS/mbedtls
+        path: mbedtls
+        ref: v3.6.2
+        submodules: recursive
+
+    - name: Build mbedtls
+      shell: bash
+      run: |
+        source ~/qnx/800/qnxsdp-env.sh
+        QNX_PROJECT_ROOT="$(pwd)/mbedtls" make -C build-files/ports/mbedtls install
