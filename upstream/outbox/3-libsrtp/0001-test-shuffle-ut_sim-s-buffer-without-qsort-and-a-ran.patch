From def1344df901212f289f4264c4ad77a8a8c039b2 Mon Sep 17 00:00:00 2001
From: Chirag <118997601+Chirag6722@users.noreply.github.com>
Date: Fri, 13 Nov 2026 09:35:18 +0530
Subject: [PATCH] test: shuffle ut_sim's buffer without qsort() and a random
 comparator

ut_init() and ut_next_index() shuffle the buffer by calling qsort()
with ut_compar(), which answers -1 or 1 at random. C (C17 7.22.5p4)
requires a qsort() comparator to give consistent answers, so this is
undefined behaviour. glibc's qsort happens to stay inside the array; a
qsort that relies on the comparator being consistent can write past
the end of it, which corrupts the test's stack and makes rdbx_driver,
replay_driver and roc_driver fail or crash.

Shuffle with a Fisher-Yates pass driven by the same test random source
(srtp_cipher_rand_for_tests) instead. The library code is unchanged.
---
 test/ut_sim.c | 24 ++++++++++++++++++++++--
 1 file changed, 22 insertions(+), 2 deletions(-)

diff --git a/test/ut_sim.c b/test/ut_sim.c
index 02099cf..b1ef0d4 100644
--- a/test/ut_sim.c
+++ b/test/ut_sim.c
@@ -62,6 +62,26 @@ int ut_compar(const void *a, const void *b)
     return r > (UINT8_MAX / 2) ? -1 : 1;
 }
 
+/*
+ * Shuffle the buffer with a Fisher-Yates pass driven by the test random
+ * source. (A qsort() with a comparator that answers at random is undefined
+ * behaviour in C, and some C libraries write outside the array when it
+ * happens.)
+ */
+static void ut_shuffle(uint32_t *buf, int n)
+{
+    int i;
+    for (i = n - 1; i > 0; i--) {
+        uint32_t r, tmp;
+        int j;
+        srtp_cipher_rand_for_tests((uint8_t *)&r, sizeof(r));
+        j = (int)(r % (uint32_t)(i + 1));
+        tmp = buf[i];
+        buf[i] = buf[j];
+        buf[j] = tmp;
+    }
+}
+
 void ut_init(ut_connection *utc)
 {
     int i;
@@ -71,7 +91,7 @@ void ut_init(ut_connection *utc)
         utc->buffer[i] = i;
     }
 
-    qsort(utc->buffer, UT_BUF, sizeof(uint32_t), ut_compar);
+    ut_shuffle(utc->buffer, UT_BUF);
 
     utc->index = UT_BUF - 1;
 }
@@ -84,7 +104,7 @@ uint32_t ut_next_index(ut_connection *utc)
     utc->index++;
     utc->buffer[0] = utc->index;
 
-    qsort(utc->buffer, UT_BUF, sizeof(uint32_t), ut_compar);
+    ut_shuffle(utc->buffer, UT_BUF);
 
     return tmp;
 }
