Subject: [qnx-porter 0001] libc-update
Source: deterministic rule
Reason: Cargo.lock pins libc 0.2.172, which does not build for QNX 8.0; newer libc releases in the same semver range do, so update it there.
---
--- a/Cargo.lock
+++ b/Cargo.lock
@@ -4,9 +4,9 @@
 
 [[package]]
 name = "libc"
-version = "0.2.172"
+version = "0.2.191"
 source = "registry+https://github.com/rust-lang/crates.io-index"
-checksum = "d750af042f7ef4f724306de029d18836c26c1765a54a6a3f094cbd23a7267ffa"
+checksum = "65cd87c9a6d60536580b316ad985726104730a5151c99845f2490428ef91240a"
 
 [[package]]
 name = "socket2"
