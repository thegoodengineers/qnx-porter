Subject: [qnx-porter 0001] link-libm
Source: deterministic rule
Reason: `__isinf` is in QNX's libm, not in libc: QNX's <math.h> implements isinf/isfinite/isnan as calls to __isinf etc. in libm, where glibc needs no library. Link with -lm.
Error: test_json_writer.c:(.text+0xd5): undefined reference to `__isinf'
---
--- a/qnx-toolchain.cmake
+++ b/qnx-toolchain.cmake
@@ -16,5 +16,5 @@
 set(CMAKE_EXE_LINKER_FLAGS_INIT "")
 set(CMAKE_SHARED_LINKER_FLAGS_INIT "")
 # Libraries the agent adds go at the end of every link line, after the objects that need them.
-set(CMAKE_C_STANDARD_LIBRARIES "")
-set(CMAKE_CXX_STANDARD_LIBRARIES "")
+set(CMAKE_C_STANDARD_LIBRARIES "-lm")
+set(CMAKE_CXX_STANDARD_LIBRARIES "-lm")
