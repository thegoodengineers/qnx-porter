Subject: [qnx-porter 0001] printf-null
Source: deterministic rule
Reason: Crash on QNX: printf() at xmltest.cpp:54 formats a NULL pointer with %s (backtrace: strlen <- printf). glibc prints "(null)" for that, QNX's libc faults; C leaves it undefined. Each %s argument of that call now goes through qnx_porter_str(), which prints "(null)" like glibc.
Error: Memory fault (SIGSEGV) in strlen <- printf on QNX
---
diff --git a/xmltest.cpp b/xmltest.cpp
index f7408d1..aa3c41b 100644
--- a/xmltest.cpp
+++ b/xmltest.cpp
@@ -21,6 +21,9 @@
 	#include <sys/types.h>
 #endif
 
+/* qnx-porter: glibc prints "(null)" for a NULL %s argument; QNX's libc faults (it is undefined C). */
+static const char *qnx_porter_str(const char *s) { return s ? s : "(null)"; }
+
 using namespace tinyxml2;
 using namespace std;
 int gPass = 0;
@@ -51,7 +54,7 @@ bool XMLTest (const char* testString, const char* expected, const char* found, b
 			printf( "%s\n", found );
 		}
 		else {
-			printf (" %s [%s][%s]\n", testString, expected, found);
+			printf (" %s [%s][%s]\n", qnx_porter_str(testString), qnx_porter_str(expected), qnx_porter_str(found));
 		}
 	}
 
