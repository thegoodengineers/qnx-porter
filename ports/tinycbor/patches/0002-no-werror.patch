Subject: [qnx-porter 0002] no-werror
Source: deterministic rule
Reason: Warning -Wint-conversion is promoted to an error by the project's -Werror. Keep it a warning (still printed in the build log) instead of editing the library's code; QNX's headers and qcc raise warnings a glibc build does not.
Error: /home/chirag/qnx-porter/ports/tinycbor/work/src/src/cbortojson.c:399:18: error: assignment to 'char *' from 'int' makes pointer from integer without a cast [-Werror=int-conversion]
---
--- a/qnx-toolchain.cmake
+++ b/qnx-toolchain.cmake
@@ -2,9 +2,9 @@
 set(CMAKE_SYSTEM_NAME QNX)
 set(CMAKE_SYSTEM_VERSION 8.0.0)
 set(CMAKE_SYSTEM_PROCESSOR x86_64)
-set(CMAKE_C_COMPILER "/home/chirag/qnx800/host/linux/x86_64/usr/bin/qcc")
+set(CMAKE_C_COMPILER "/home/chirag/qnx-porter/ports/tinycbor/work/wrap/qcc")
 set(CMAKE_C_COMPILER_TARGET gcc_ntox86_64)
-set(CMAKE_CXX_COMPILER "/home/chirag/qnx800/host/linux/x86_64/usr/bin/q++")
+set(CMAKE_CXX_COMPILER "/home/chirag/qnx-porter/ports/tinycbor/work/wrap/q++")
 set(CMAKE_CXX_COMPILER_TARGET gcc_ntox86_64_cxx)
 set(CMAKE_SYSROOT "/home/chirag/qnx800/target/qnx")
 set(CMAKE_FIND_ROOT_PATH "/home/chirag/qnx800/target/qnx" "/home/chirag/qnx800/target/qnx/x86_64" "/home/chirag/qnx-porter/ports/tinycbor/work")
@@ -17,7 +17,7 @@
 set(CMAKE_CXX_FLAGS_INIT "-g -D_QNX_SOURCE")
 set(CMAKE_EXE_LINKER_FLAGS_INIT "-L/home/chirag/qnx-porter/ports/tinycbor/work/stubs")
